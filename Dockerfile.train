# One-shot training worker for the extra Compose stack.
# Talks to MLflow by service name: http://mlflow:5000
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    GIT_PYTHON_REFRESH=quiet \
    MLFLOW_TRACKING_URI=http://mlflow:5000

WORKDIR /app

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir \
    -i ${PIP_INDEX_URL} \
    --trusted-host ${PIP_TRUSTED_HOST} \
    -r /app/requirements.txt

COPY src /app/src
COPY data /app/data

# Default: one LR run with registration. Override command in compose for other runs.
CMD ["python", "-m", "src.train", "--algorithm", "lr", "--C", "1", "--register"]
